                <x>20</x>
                <y>10</y>
                <width>630</width>
                <height>100</height>
            </rect>
        </property>
        <property name="title">
            <string>Files</string>
        </property>
        <widget class="QLabel">
            <property name="name">
                <cstring>receptorFileLabel</cstring>
            </property>
            <property name="geometry">
