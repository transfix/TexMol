                <cstring>ligandFileLabel</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>10</x>
                    <y>60</y>
                    <width>150</width>
                    <height>20</height>
                </rect>
            </property>
            <property name="text">
                <string>Ligand File (pdb)</string>
            </property>
        </widget>
        <widget class="QLineEdit">
            <property name="name">
                <cstring>RF_TB</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>170</x>
                    <y>20</y>
                    <width>330</width>
                    <height>22</height>
                </rect>
            </property>
        </widget>
        <widget class="QLineEdit">
            <property name="name">
                <cstring>LF_TB</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>170</x>
                    <y>60</y>
                    <width>330</width>
                    <height>22</height>
                </rect>
            </property>
        </widget>
        <widget class="QPushButton">
            <property name="name">
                <cstring>receptorFileButton</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>510</x>
                    <y>20</y>
                    <width>100</width>
                    <height>24</height>
                </rect>
            </property>
            <property name="text">
                <string>Browse</string>
