                    <x>10</x>
                    <y>20</y>
                    <width>150</width>
                    <height>20</height>
                </rect>
            </property>
            <property name="text">
                <string>Receptor File (pdb)</string>
            </property>
        </widget>
        <widget class="QLabel">
