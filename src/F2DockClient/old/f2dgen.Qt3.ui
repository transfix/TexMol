            </rect>
        </property>
        <property name="text">
            <string>Generate f2ds</string>
        </property>
    </widget>
</widget>
<connections>
    <connection>
        <sender>genButton</sender>
        <signal>clicked()</signal>
        <receiver>f2dGen</receiver>
        <slot>genButtonSlot()</slot>
    </connection>
    <connection>
        <sender>receptorFileButton</sender>
        <signal>clicked()</signal>
        <receiver>f2dGen</receiver>
        <slot>rfButtonSlot()</slot>
    </connection>
    <connection>
        <sender>ligadFileButton</sender>
        <signal>clicked()</signal>
        <receiver>f2dGen</receiver>
        <slot>lfButtonSlot()</slot>
    </connection>
</connections>
<includes>
    <include location="local" impldecl="in implementation">f2dgen.ui.h</include>
</includes>
<slots>
    <slot>rfButtonSlot()</slot>
    <slot>lfButtonSlot()</slot>
    <slot>genButtonSlot()</slot>
</slots>
<pixmapinproject/>
<layoutdefaults spacing="6" margin="11"/>
</UI>
