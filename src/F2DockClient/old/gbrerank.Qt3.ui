        <slot>resetSlot()</slot>
    </connection>
    <connection>
        <sender>rerankButton</sender>
        <signal>clicked()</signal>
        <receiver>GBRerank</receiver>
        <slot>rerankSlot()</slot>
    </connection>
</connections>
<includes>
