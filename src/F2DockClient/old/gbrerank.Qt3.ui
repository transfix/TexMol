<connections>
    <connection>
        <sender>receptorPQRButton</sender>
        <signal>clicked()</signal>
        <receiver>GBRerank</receiver>
        <slot>selectReceptorPQRFileSlot()</slot>
    </connection>
    <connection>
        <sender>ligandPQRButton</sender>
        <signal>clicked()</signal>
        <receiver>GBRerank</receiver>
        <slot>selectLigandPQRFileSlot()</slot>
