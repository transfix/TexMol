</includes>
<slots>
    <slot>selectReceptorPQRFileSlot()</slot>
    <slot>selectLigandPQRFileSlot()</slot>
    <slot>selectReceptorQUADFileSlot()</slot>
    <slot>selectLigandQUADFileSlot()</slot>
