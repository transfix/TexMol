    </connection>
</connections>
<slots>
    <slot>dockSlot()</slot>
    <slot>f2dgenSlot()</slot>
    <slot>rerankSlot()</slot>
    <slot>quadgenSlot()</slot>
    <slot>jobdetSlot()</slot>
    <slot>resultSlot()</slot>
    <slot>selectSlot()</slot>
    <slot>saveSlot()</slot>
    <slot>loadSlot()</slot>
</slots>
<pixmapinproject/>
<layoutdefaults spacing="6" margin="11"/>
</UI>
