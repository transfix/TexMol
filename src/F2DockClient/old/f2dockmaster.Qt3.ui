<connections>
    <connection>
        <sender>detailButton</sender>
        <signal>clicked()</signal>
        <receiver>f2dockmaster</receiver>
        <slot>jobdetSlot()</slot>
    </connection>
    <connection>
        <sender>dockButton</sender>
        <signal>clicked()</signal>
        <receiver>f2dockmaster</receiver>
        <slot>dockSlot()</slot>
