    <connection>
        <sender>coarseRB</sender>
        <signal>clicked()</signal>
        <receiver>quadGen</receiver>
        <slot>coarseSlot()</slot>
    </connection>
</connections>
<slots>
    <slot>rfButtonSlot()</slot>
    <slot>lfButtonSlot()</slot>
    <slot>genButtonSlot()</slot>
    <slot>fineSlot()</slot>
    <slot>coarseSlot()</slot>
</slots>
