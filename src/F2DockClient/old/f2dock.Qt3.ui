    <tabstop>elecWeightTB</tabstop>
    <tabstop>avdButton</tabstop>
    <tabstop>resetButton</tabstop>
    <tabstop>dockButton</tabstop>
</tabstops>
<includes>
    <include location="local" impldecl="in implementation">f2dock.ui.h</include>
</includes>
<slots>
    <slot>selectReceptorFileSlot()</slot>
    <slot>selectLigandFileSlot()</slot>
    <slot>selectRMSDFileSlot()</slot>
    <slot>selectOutputFileSlot()</slot>
    <slot>advencedOptionsSlot()</slot>
    <slot>dockSlot()</slot>
    <slot>defaultSlot()</slot>
    <slot>uuSlot()</slot>
    <slot>bbSlot()</slot>
    <slot>selectReceptorPDBSlot()</slot>
</slots>
<layoutdefaults spacing="6" margin="11"/>
</UI>
