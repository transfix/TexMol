<connections>
    <connection>
        <sender>receptorFileButton</sender>
        <signal>clicked()</signal>
        <receiver>F2Dock</receiver>
        <slot>selectReceptorFileSlot()</slot>
    </connection>
    <connection>
        <sender>ligadFileButton</sender>
        <signal>clicked()</signal>
        <receiver>F2Dock</receiver>
        <slot>selectLigandFileSlot()</slot>
    </connection>
    <connection>
        <sender>avdButton</sender>
        <signal>clicked()</signal>
        <receiver>F2Dock</receiver>
        <slot>advencedOptionsSlot()</slot>
    </connection>
    <connection>
        <sender>rmsdFileButton</sender>
        <signal>clicked()</signal>
        <receiver>F2Dock</receiver>
        <slot>selectRMSDFileSlot()</slot>
    </connection>
    <connection>
        <sender>outFileButton</sender>
        <signal>clicked()</signal>
        <receiver>F2Dock</receiver>
        <slot>selectOutputFileSlot()</slot>
    </connection>
    <connection>
        <sender>dockButton</sender>
        <signal>clicked()</signal>
        <receiver>F2Dock</receiver>
        <slot>dockSlot()</slot>
    </connection>
    <connection>
        <sender>resetButton</sender>
        <signal>clicked()</signal>
        <receiver>F2Dock</receiver>
        <slot>defaultSlot()</slot>
    </connection>
    <connection>
        <sender>bbDockRB</sender>
        <signal>clicked()</signal>
        <receiver>F2Dock</receiver>
        <slot>bbSlot()</slot>
    </connection>
    <connection>
        <sender>uuDockRB</sender>
        <signal>clicked()</signal>
        <receiver>F2Dock</receiver>
        <slot>uuSlot()</slot>
    </connection>
    <connection>
        <sender>receptorPDBButton</sender>
        <signal>clicked()</signal>
        <receiver>F2Dock</receiver>
        <slot>selectReceptorPDBSlot()</slot>
    </connection>
</connections>
<tabstops>
